# Python Virtual Environments
.venv/
venv/
env/
ENV/

# Byte-compiled / Optimized files
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.log
*$py.class

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
*.pem

# IDE / Editor folders
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Project runtime data
backend/media/
backend/data/*.parquet
backend/data/*.csv
backend/data/*.json

# Local databases / temp files
*.sqlite3
*.db
*.tmp

# Keep the repo's private local env file tracked for this project
!backend/.env
